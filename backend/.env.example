# ==============================================================================
# OSPREY BACKEND — ENVIRONMENT CONFIGURATION (DEVELOPMENT TEMPLATE)
# ==============================================================================
# Copy this file to .env in backend/ or root directory:
#   cp .env.example .env
#
# Do NOT place production secrets or live database credentials in this file.
# ==============================================================================

APP_NAME=OSPREY Intelligence API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# Allowed CORS Origins (JSON list format or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Neon PostgreSQL + PostGIS Connection URL (psycopg3 driver)
# Example format: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Copernicus Data Space Ecosystem (CDSE) Configuration (Step 10A & 10B)
COPERNICUS_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CLIENT_ID=cdse-public
CDSE_USERNAME=your_cdse_username@example.com
CDSE_PASSWORD=your_cdse_password
CDSE_DOWNLOAD_URL=https://download.dataspace.copernicus.eu/odata/v1/Products
OSPREY_DATA_ROOT=data

